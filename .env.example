# Public browser configuration. These are not service-role or payment secret keys.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
VITE_PAYPAL_CLIENT_ID=
VITE_INSTAGRAM_URL=
VITE_FACEBOOK_URL=
VITE_TIKTOK_URL=

# Server-only. Set through your hosting provider; never prefix these with VITE_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_SITE_URL=https://your-store.example
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
CHECKOUT_CRON_SECRET=
# Optional country allowlist; blank retains the existing worldwide country selection.
# This changes destinations, not shipping prices. Confirm commercial shipping rates before launch.
SHIPPING_COUNTRIES=
RESEND_API_KEY=
