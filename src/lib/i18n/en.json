  "faq": {
    "title": "Frequently Asked Questions",
    "items": [
      {
        "q": "How long does shipping take?",
        "a": "Most orders ship within 1–2 business days and arrive in 3–5 business days domestically, or 7–14 days internationally."
      },
      {
        "q": "Are your salt lamps authentic?",
        "a": "Yes — every lamp is hand-carved from salt mined directly at the Khewra mine in Pakistan, the world's second-largest salt mine."
      },
      {
        "q": "How do I care for my leather?",
        "a": "Wipe with a soft, dry cloth. Condition every 3–6 months with a quality leather balm and keep away from prolonged sunlight."
      },
      {
        "q": "Can I return an item?",
        "a": "Yes, we accept returns within 30 days of delivery for unused items in original condition. See our Returns page for details."
      }
    ]
  },
  "shipping": {
    "title": "Shipping Info",
    "p1": "We ship worldwide from our workshop in Sialkot, Pakistan. Domestic orders arrive in 3–5 business days; international orders take 7–14 business days.",
    "p2": "Shipping is free on orders over €100. A tracking number is emailed once your order ships.",
    "p3": "Customs duties for international orders are the responsibility of the buyer."
  },
  "returns": {
    "title": "Returns",
    "p1": "We accept returns within 30 days of delivery. Items must be unused, in original packaging, and accompanied by proof of purchase.",
    "p2": "Refunds are issued to the original payment method within 5–7 business days of receiving the return.",
    "p3": "Custom or engraved pieces are final sale and cannot be returned."
  },
  "privacy": {
    "title": "Privacy Policy",
    "p1": "We collect only the information needed to fulfil your order — name, address, email, and payment details. We never sell your data.",
